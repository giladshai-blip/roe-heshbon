    "queryPlanner": true,
    "contextBudget": true,
    "contextInstructionAudit": true,
    "userFacingGlossary": true,
    "gabiLanguageStyle": "docs/gabi-language-style.md"
  },
  "optimization": {
    "profile": "branch-wide-3.0.1",
    "activeDocsOnlyByDefault": true,
    "historicalDocsDefaultLoad": false,
    "engineeringSkillsLoading": "lazy",
    "canonicalSkillManifest": "agents/dev-engineering-agent/skills/manifest.json",
    "deduplicateRuntimeRules": true,
    "legacyReferencesAllowedOnlyForCompatibilityOrHistory": true
  },
  "financial": {
    "sourceOfTruth": "רואה חשבון - מערכת פיננסית",
    "freshnessRequired": true,
    "financialSelfCheckRequired": true,
    "readbackRequiredForWrites": true
  },
  "engineering": {
    "activeBranch": "dev",
    "versionOwner": "dev-engineering-agent",
    "proactiveBugHuntPerTask": true,
    "continuousBackgroundMonitoring": false,
    "gitHubLinksRequiredForCodeHandoff": true,
    "engineeringSkills": true,
    "engineeringSkillsLoading": "lazy",
    "engineeringSkillsManifest": "agents/dev-engineering-agent/skills/manifest.json",
    "contextAuditSkill": "context-instruction-audit",
    "userFacingGlossary": "docs/user-facing-glossary.md"
  },
  "restore": {
    "strategy": "git-history-or-explicit-backup-ref",
    "defaultBranch": "dev"
  }
